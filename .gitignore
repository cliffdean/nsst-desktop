# 依賴與建置輸出
node_modules/
dist/
out/
release/
build/

# 日誌(含 start-hidden.bat 產生的 start-out.log / start-err.log)
*.log
logs/
npm-debug.log*

# 環境變數 / 本機設定
.env
.env.*
!.env.example

# 快取
.cache/
.eslintcache
*.tsbuildinfo

# 編輯器
.vscode/
.idea/
*.swp
*.swo

# 作業系統
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Claude Code 本機設定
.claude/settings.local.json

# 電子紙出廠固件備份(32MB，內含Wi-Fi密碼等裝置資料，不可提交)
firmware/backup/

# 電子紙固件：WiFi帳密、字型檔(由 firmware/fonts/make_fonts.py 產生)
firmware/**/secrets.h
firmware/fonts/*.ttf

# Playwright MCP 暫存
.playwright-mcp/
